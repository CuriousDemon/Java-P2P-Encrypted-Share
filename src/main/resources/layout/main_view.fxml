<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox alignment="CENTER" spacing="15.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.himangshu.ui.MainController">

    <Label text="Available Peers" style="-fx-font-weight: bold;"/>

    <!-- This list will show the discovered IPs -->
    <ListView fx:id="peerListView" prefHeight="150" prefWidth="250"/>

    <HBox alignment="CENTER" spacing="10">
        <Button text="Start Receiver" onAction="#handleStartReceiver"/>
        <Button text="Send to Selected" onAction="#handleSendFile"/>
    </HBox>

    <Label fx:id="statusLabel" text="Status: Ready" style="-fx-text-fill: gray;"/>
</VBox>